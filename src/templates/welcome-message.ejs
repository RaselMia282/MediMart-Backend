<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to MediMart</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f3f7fc;
  font-family: Arial, Helvetica, sans-serif;
  color: #1e293b;
">

  <table width="100%" cellpadding="0" cellspacing="0" border="0"
    style="background-color: #f3f7fc; padding: 40px 15px;">
    <tr>
      <td align="center">

        <table width="100%" cellpadding="0" cellspacing="0" border="0"
          style="
            max-width: 520px;
            background-color: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid #e2eaf5;
          ">

          <!-- Brand Header -->
          <tr>
            <td align="center" style="
              background-color: #155eef;
              padding: 30px 20px;
            ">
              <h1 style="
                margin: 0;
                color: #ffffff;
                font-size: 29px;
                font-weight: 700;
                letter-spacing: -1px;
              ">
                Medi<span style="color: #bfdbfe;">Mart</span>
              </h1>

              <p style="
                margin: 8px 0 0;
                color: #dbeafe;
                font-size: 12px;
                letter-spacing: 1.5px;
                text-transform: uppercase;
              ">
                Healthcare Made Simpler
              </p>
            </td>
          </tr>

          <!-- Main Content -->
          <tr>
            <td style="padding: 38px 30px 20px;">

              <h2 style="
                margin: 0 0 16px;
                color: #102a56;
                font-size: 25px;
                font-weight: 700;
                text-align: center;
              ">
                Welcome to MediMart!
              </h2>

              <p style="
                margin: 0 0 16px;
                color: #475569;
                font-size: 15px;
                line-height: 1.7;
              ">
                Hello <strong style="color: #102a56;"><%= name %></strong>,
              </p>

              <p style="
                margin: 0 0 26px;
                color: #475569;
                font-size: 15px;
                line-height: 1.8;
              ">
                We're thrilled to have you on board. Your account is all set,
                and you can now explore trusted healthcare products, compare
                verified sellers, and manage your orders with ease.
              </p>

              <!-- Welcome Highlight Box -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="
                  background-color: #eff6ff;
                  border: 1px solid #bfdbfe;
                  border-radius: 12px;
                ">
                <tr>
                  <td align="center" style="padding: 24px 20px;">

                    <p style="
                      margin: 0 0 8px;
                      color: #2563eb;
                      font-size: 12px;
                      font-weight: 700;
                      letter-spacing: 1.5px;
                      text-transform: uppercase;
                    ">
                      Account Active
                    </p>

                    <p style="
                      margin: 0;
                      color: #102a56;
                      font-size: 16px;
                      font-weight: 700;
                      line-height: 1.5;
                    ">
                      Trusted Care, Right When You Need It
                    </p>

                  </td>
                </tr>
              </table>

              <!-- Closing Note -->
              <p style="
                margin: 24px 0 0;
                color: #64748b;
                font-size: 13px;
                line-height: 1.7;
                text-align: center;
              ">
                If you ever need assistance, our support team is always here
                to help you.
              </p>

            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding: 12px 30px 0;">
              <div style="
                height: 1px;
                background-color: #e2eaf5;
              "></div>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding: 25px 25px 30px;">

              <p style="
                margin: 0 0 9px;
                color: #155eef;
                font-size: 14px;
                font-weight: 700;
              ">
                Your Health, Our Priority.
              </p>

              <p style="
                margin: 0 0 12px;
                color: #94a3b8;
                font-size: 12px;
                line-height: 1.6;
              ">
                This is an automated email. Please do not reply.
              </p>

              <p style="
                margin: 0;
                color: #94a3b8;
                font-size: 11px;
              ">
                &copy; <%= new Date().getFullYear() %> MediMart.
                All rights reserved.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>